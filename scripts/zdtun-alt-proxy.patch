   udp_mapping_t *udp_mappings;
 } zdtun_t;
@@ -204,7 +209,7 @@ static uint8_t sock_ipver(zdtun_t *tun, zdtun_conn_t *conn) {
   if(conn->proxy_mode == PROXY_DNAT)
     return conn->dnat->ipver;
   else if(conn->proxy_mode == PROXY_SOCKS5)
