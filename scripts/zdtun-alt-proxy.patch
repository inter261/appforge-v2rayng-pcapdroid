--- a/socks5.c
+++ b/socks5.c
@@ -62,9 +62,12 @@ typedef enum {
 
 /* ******************************************************* */
 
+#define S5_USER(tun, conn) ((conn)->socks5_alt ? (tun)->socks5_alt_user : (tun)->socks5_user)
+#define S5_PASS(tun, conn) ((conn)->socks5_alt ? (tun)->socks5_alt_pass : (tun)->socks5_pass)
+
 int socks5_connect(zdtun_t *tun, zdtun_conn_t *conn) {
   // ver, nauth, no_auth|username_password
-  uint8_t hello[] = {5, 1, tun->socks5_user ? SOCKS5_AUTH_USERNAME_PASSWORD : 0};
+  uint8_t hello[] = {5, 1, S5_USER(tun, conn) ? SOCKS5_AUTH_USERNAME_PASSWORD : 0};
 
   if(send(conn->sock, hello, 3, 0) < 0)
     return close_with_socket_error(tun, conn, "SOCKS5_HELLO send");
@@ -80,8 +83,8 @@ int socks5_connect(zdtun_t *tun, zdtun_conn_t *conn) {
 
 // Client auth request - https://datatracker.ietf.org/doc/html/rfc1929
 static int socks5_auth(zdtun_t *tun, zdtun_conn_t *conn) {
-  int user_len = strlen(tun->socks5_user);
-  int pass_len = strlen(tun->socks5_pass);
+  int user_len = strlen(S5_USER(tun, conn));
+  int pass_len = strlen(S5_PASS(tun, conn));
   int i = 0;
 
   uint8_t auth_req[3 + user_len + pass_len];
@@ -89,11 +92,11 @@ static int socks5_auth(zdtun_t *tun, zdtun_conn_t *conn) {
   auth_req[i++] = 1;
 
   auth_req[i++] = user_len;
-  memcpy(auth_req + i, tun->socks5_user, user_len);
+  memcpy(auth_req + i, S5_USER(tun, conn), user_len);
   i += user_len;
 
   auth_req[i++] = pass_len;
-  memcpy(auth_req + i, tun->socks5_pass, pass_len);
+  memcpy(auth_req + i, S5_PASS(tun, conn), pass_len);
   i += pass_len;
 
   if(send(conn->sock, auth_req, i, 0) < 0)
@@ -150,7 +153,7 @@ int handle_socks5_reply(zdtun_t *tun, zdtun_conn_t *conn, char *data, int len) {
     }
 
     if(reply->cauth != 0) {
-      if((reply->cauth == SOCKS5_AUTH_USERNAME_PASSWORD) && tun->socks5_user)
+      if((reply->cauth == SOCKS5_AUTH_USERNAME_PASSWORD) && S5_USER(tun, conn))
         return socks5_auth(tun, conn);
 
       error("SOCKS5 bad auth: %d", reply->cauth);
diff --git a/zdtun.c b/zdtun.c
